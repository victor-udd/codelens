NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Matches the dedicated dev cluster from `npm run db:start` (see README).
DATABASE_URL="postgresql://postgres@127.0.0.1:55432/codelens_dev?schema=public"

REQUEST_BODY_LIMIT_BYTES=131072
MAX_CONTENT_BYTES=65536
PROVIDER_TIMEOUT_MS=15000
MAX_PROVIDER_ATTEMPTS=3
AI_MAX_OUTPUT_TOKENS=4096
AI_RESPONSE_MAX_BYTES=1048576

# Recovery limits. STALE_PROCESSING_MS must exceed
# PROVIDER_TIMEOUT_MS * MAX_PROVIDER_ATTEMPTS.
MAX_PROCESSING_ATTEMPTS=3
STALE_PROCESSING_MS=90000
STALE_PENDING_MS=300000
RECOVERY_BATCH_SIZE=50

# AI adapter (optional until a review is sent to a provider)
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Comma-separated API keys required for every /reviews and /api/reviews call.
# Replace these development-only values before exposing the service.
API_KEYS=dev-user-key
ADMIN_API_KEYS=dev-admin-key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
