NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codelens?schema=public"

# Reserved for later phases; validated now, unused until implemented.
REQUEST_BODY_LIMIT_BYTES=131072
MAX_CONTENT_BYTES=65536
PROVIDER_TIMEOUT_MS=15000
MAX_PROVIDER_ATTEMPTS=3
STALE_PROCESSING_MS=90000
STALE_PENDING_MS=300000

# AI adapter (optional until a review is sent to a provider)
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
